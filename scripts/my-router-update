#!/bin/sh
# Pull the latest master from GitHub and apply it to this router.
# There is no git binary on OpenWrt, so we compare the master commit SHA via
# the GitHub API and download a tarball when it differs.
#
#   my-router-update           check and apply only if the SHA changed
#   my-router-update --force   re-apply even if the SHA is unchanged
#   my-router-update --check   report only, change nothing (exit 10 = update available)

set -u

REPO="${MY_ROUTER_REPO:-Dimignat/my-router}"
BRANCH="${MY_ROUTER_BRANCH:-master}"
STATE_DIR=/etc/my-router
WORK=/tmp/my-router-update.$$
LOCK=/var/lock/my-router-update.lock

FORCE=0; CHECK_ONLY=0
case "${1:-}" in
    --force) FORCE=1 ;;
    --check) CHECK_ONLY=1 ;;
esac

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; logger -t my-router-update "$*"; }
cleanup() { rm -rf "$WORK"; rmdir "$LOCK" 2>/dev/null; }

# Single-instance guard: cron and the GUI button can both call this.
if ! mkdir "$LOCK" 2>/dev/null; then
    log "another update is already running, skipping"
    exit 0
fi
trap cleanup EXIT INT TERM

mkdir -p "$STATE_DIR" "$WORK"
current=$(cat "$STATE_DIR/version" 2>/dev/null || echo "")

# Ask GitHub for the current head of the branch.
#
# The API sends "cache-control: public, max-age=60, s-maxage=60", so for a
# minute after a push the CDN edge still serves the PREVIOUS commit and the
# router concludes it is up to date. A unique query parameter makes each
# request its own cache key, which is the only thing that reliably defeats it
# (request-side no-cache headers and the git/refs endpoint do not).
cache_bust=$(date +%s)-$$
remote=$(curl -fsS --max-time 30 \
    -H 'Accept: application/vnd.github.sha' \
    -H 'Cache-Control: no-cache' \
    "https://api.github.com/repos/$REPO/commits/$BRANCH?cb=$cache_bust" 2>/dev/null)

# Guard against a proxy handing back an error page or HTML instead of a SHA.
case "$remote" in
    *[!0-9a-f]* | "") remote="" ;;
esac

if [ -z "$remote" ]; then
    log "could not reach GitHub (offline or repo unavailable); keeping current version"
    exit 1
fi

log "current=${current:-none} remote=$remote"

if [ "$CHECK_ONLY" = "1" ]; then
    [ "$current" = "$remote" ] && { log "up to date"; exit 0; }
    log "update available: $remote"
    exit 10
fi

if [ "$current" = "$remote" ] && [ "$FORCE" = "0" ]; then
    log "already up to date"
    exit 0
fi

# A commit that already failed its health check is not retried every 15
# minutes; --force overrides, so a fixed release can be pulled deliberately.
if [ "$FORCE" = "0" ] && [ -f "$STATE_DIR/bad-version" ] &&
   [ "$(cat "$STATE_DIR/bad-version")" = "$remote" ]; then
    log "$remote previously failed its health check; skipping (use --force to retry)"
    exit 0
fi

log "downloading $REPO@$remote"
if ! curl -fsSL --max-time 120 \
        "https://codeload.github.com/$REPO/tar.gz/$remote" \
        -o "$WORK/src.tar.gz"; then
    log "download failed; keeping current version"
    exit 1
fi

if ! tar -xzf "$WORK/src.tar.gz" -C "$WORK"; then
    log "tarball is corrupt; keeping current version"
    exit 1
fi

SRC=$(find "$WORK" -maxdepth 1 -type d -name "*-$remote*" | head -1)
[ -z "$SRC" ] && SRC=$(find "$WORK" -maxdepth 1 -mindepth 1 -type d ! -name '*.tar.gz' | head -1)

# Structural check on the downloaded tree. Existence alone is not enough --
# an empty index.html would sail through -- so also require the page to carry
# the markup the GUI depends on.
if [ ! -d "$SRC/www" ] || [ ! -f "$SRC/cgi-bin/router-api" ] ||
   [ ! -x "$SRC/scripts/install.sh" ]; then
    log "downloaded tree is missing expected files; aborting without changes"
    exit 1
fi
if ! grep -q 'id="btn-reconnect"' "$SRC/www/index.html" 2>/dev/null; then
    log "downloaded index.html does not look like the GUI; aborting without changes"
    exit 1
fi

# Snapshot what is live now, so a bad release can be undone on the device
# without anyone having to SSH in.
SNAP="$STATE_DIR/rollback"
rm -rf "$SNAP.new"
mkdir -p "$SNAP.new"
[ -d /www/app ] && cp -r /www/app "$SNAP.new/app"
[ -f /www/cgi-bin/router-api ] && cp /www/cgi-bin/router-api "$SNAP.new/router-api"
[ -f /www/cgi-bin/index-router ] && cp /www/cgi-bin/index-router "$SNAP.new/index-router"
[ -f /usr/bin/my-router-update ] && cp /usr/bin/my-router-update "$SNAP.new/my-router-update"
cp "$STATE_DIR/version" "$SNAP.new/version" 2>/dev/null || echo "" > "$SNAP.new/version"
rm -rf "$SNAP"
mv "$SNAP.new" "$SNAP"

# Put the live files back the way they were before this run.
restore_snapshot() {
    [ -d "$SNAP/app" ] || return 1
    rm -rf /www/app.failed
    [ -d /www/app ] && mv /www/app /www/app.failed
    cp -r "$SNAP/app" /www/app
    [ -f "$SNAP/router-api" ]  && cp "$SNAP/router-api"  /www/cgi-bin/router-api
    [ -f "$SNAP/index-router" ] && cp "$SNAP/index-router" /www/cgi-bin/index-router
    [ -f "$SNAP/my-router-update" ] && cp "$SNAP/my-router-update" /usr/bin/my-router-update
    chmod +x /www/cgi-bin/router-api /www/cgi-bin/index-router /usr/bin/my-router-update 2>/dev/null
    cp "$SNAP/version" "$STATE_DIR/version" 2>/dev/null
    /etc/init.d/uhttpd restart >/dev/null 2>&1
    return 0
}

# Does the GUI actually work? Checked over real HTTP against the live server,
# so a broken CGI, a missing asset or an unparseable page is caught.
health_ok() {
    local base="http://127.0.0.1"
    # The control API must answer with JSON that reports success.
    curl -fsS --max-time 20 "$base/cgi-bin/router-api?action=status" 2>/dev/null \
        | grep -q '"ok":true' || return 1
    # The page itself must be served and carry its buttons.
    curl -fsS --max-time 15 "$base/app/" 2>/dev/null \
        | grep -q 'id="btn-reconnect"' || return 1
    # Stylesheet and script must be fetchable (catches a half-copied tree).
    curl -fsS --max-time 15 -o /dev/null "$base/app/style.css" 2>/dev/null || return 1
    curl -fsS --max-time 15 -o /dev/null "$base/app/app.js" 2>/dev/null || return 1
    return 0
}

# Hand off to the repo's own installer so update logic ships with the content.
log "running installer"
if ! sh "$SRC/scripts/install.sh" --from-update "$SRC"; then
    log "installer failed; rolling back"
    restore_snapshot && log "rolled back to previous version" ||
        log "WARNING: no snapshot to roll back to"
    exit 1
fi

# Give uhttpd a moment to pick the new files up before judging them.
sleep 2

if ! health_ok; then
    log "health check FAILED after update to $remote; rolling back"
    if restore_snapshot; then
        sleep 2
        if health_ok; then
            log "rolled back successfully; staying on $(cat "$STATE_DIR/version" 2>/dev/null)"
        else
            log "WARNING: still unhealthy after rollback -- manual repair needed"
        fi
        # Record the bad commit so the next run does not reinstall it in a loop.
        echo "$remote" > "$STATE_DIR/bad-version"
    else
        log "WARNING: no snapshot to roll back to"
    fi
    exit 1
fi

echo "$remote" > "$STATE_DIR/version"
date '+%Y-%m-%d %H:%M:%S' > "$STATE_DIR/last-update"
rm -f "$STATE_DIR/bad-version"
log "updated to $remote"
